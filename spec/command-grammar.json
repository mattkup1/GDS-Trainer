[
  {"name": "sign_out", "pattern": "^SO$", "handler": "SIGN_OUT"},
  {"name": "help", "pattern": "^HELP", "handler": "HELP"},
  {"name": "availability_a", "pattern": "^A(\\d{1,2})([A-Z]{3})([A-Z]{3})([A-Z]{3})$", "handler": "AVAILABILITY"},
  {"name": "availability_1", "pattern": "^1(\\d{1,2})([A-Z]{3})([A-Z]{3})([A-Z]{3})$", "handler": "AVAILABILITY"},
  {"name": "sell_from_avail", "pattern": "^0(\\d{1,2})([A-Z])(\\d{1,2})$", "handler": "SELL_FROM_AVAIL"},
  {"name": "long_sell", "pattern": "^0([A-Z]{2})(\\d{1,4})([A-Z])(\\d{1,2})([A-Z]{3})([A-Z]{3})([A-Z]{3})([A-Z]{2})(\\d{1,2})$", "handler": "LONG_SELL"},
  {"name": "name_field", "pattern": "^-", "handler": "NAME_FIELD"},
  {"name": "phone", "pattern": "^9", "handler": "PHONE"},
  {"name": "general_remark", "pattern": "^5(?!$)", "handler": "GENERAL_REMARK"},
  {"name": "received_from", "pattern": "^6(?!$)", "handler": "RECEIVED_FROM"},
  {"name": "price_itinerary", "pattern": "^(WP|WPNCS)(?:/([A-Z0-9]{3,10}))?$", "handler": "PRICE_ITINERARY"},
  {"name": "ticketing_at_will", "pattern": "^7TAW/?$", "handler": "TICKETING_AT_WILL"},
  {"name": "ticketing_at_will_dated", "pattern": "^7TAW(\\d{1,2})([A-Z]{3})/(\\d{3,4})?$", "handler": "TICKETING_AT_WILL_DATED"},
  {"name": "ticketing_time_limit", "pattern": "^7TAX(\\d{1,2})([A-Z]{3})/(\\d{3,4})$", "handler": "TICKETING_TIME_LIMIT"},
  {"name": "fop_cash", "pattern": "^FPCASH$", "handler": "FOP_CASH"},
  {"name": "fop_check", "pattern": "^FPCHECK$", "handler": "FOP_CHECK"},
  {"name": "fop_credit_card", "pattern": "^FPCC([A-Z]{2})(\\d{13,19})/(\\d{2})(\\d{2})$", "handler": "FOP_CREDIT_CARD"},
  {"name": "issue_tickets", "pattern": "^TKTT$", "handler": "ISSUE_TICKETS"},
  {"name": "docs", "pattern": "^3DOCS([A-Z])/([A-Z]{2})/([A-Z0-9]{5,15})/([A-Z]{2})/(\\d{1,2}[A-Z]{3}\\d{2})/([MF])/(\\d{1,2}[A-Z]{3}\\d{2})-(\\d{1,2})(?:\\.(\\d{1,2}))?$", "handler": "DOCS"},
  {"name": "ssr_fqtv", "pattern": "^3FQTV([A-Z]{2})(\\d{5,12})(?:/([A-Z]{3}))?$", "handler": "SSR_FQTV"},
  {"name": "osi", "pattern": "^3OSI([A-Z]{2})\\s*(.+)$", "handler": "OSI"},
  {"name": "ssr", "pattern": "^3([A-Z]{4})(?:-(\\d{1,2}))?(?:/(.+))?$", "handler": "SSR"},
  {"name": "seat_map", "pattern": "^4(\\d{1,2})$", "handler": "SEAT_MAP"},
  {"name": "seat_assign", "pattern": "^4(\\d{1,2})-(\\d{1,2}[A-F])$", "handler": "SEAT_ASSIGN"},
  {"name": "decode_airport", "pattern": "^DC([A-Z]{3})$", "handler": "DECODE_AIRPORT"},
  {"name": "search_airports", "pattern": "^DAN(.+)$", "handler": "SEARCH_AIRPORTS"},
  {"name": "pnr_redisplay", "pattern": "^\\*R?$", "handler": "PNR_REDISPLAY"},
  {"name": "pnr_history", "pattern": "^\\*H$", "handler": "PNR_HISTORY"},
  {"name": "pnr_retrieve", "pattern": "^\\*([A-Z0-9]{6})$", "handler": "PNR_RETRIEVE"},
  {"name": "cancel_itinerary", "pattern": "^XI$", "handler": "CANCEL_ITINERARY"},
  {"name": "cancel_elements", "pattern": "^X([\\d,\\-]+)$", "handler": "CANCEL_ELEMENTS"},
  {"name": "ignore", "pattern": "^IG$", "handler": "IGNORE"},
  {"name": "end_transact_er", "pattern": "^ER$", "handler": "END_TRANSACT_ER"},
  {"name": "end_transact_et", "pattern": "^ET$", "handler": "END_TRANSACT_ET"}
]
